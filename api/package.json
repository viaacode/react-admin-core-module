{
  "name": "@meemoo/admin-core-api",
  "version": "7.0.0",
  "description": "The backend routes to support the screens in the Admin Core dashboard",
  "author": "Bert Verhelst <bert.verhelst@studiohyperdrive.be>",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "private": false,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "copy-to-proxy-hetarchief": "rimraf ../../hetarchief-proxy/node_modules/@meemoo/admin-core-api/dist ../../hetarchief-proxy/node_modules/.cache && cp -r dist package.json ../../hetarchief-proxy/node_modules/@meemoo/admin-core-api",
    "copy-to-proxy-avo": "rimraf ../../avo2-proxy/server/node_modules/@meemoo/admin-core-api/dist ../../avo2-proxy/server/node_modules/.cache && cp -r dist package.json ../../avo2-proxy/server/node_modules/@meemoo/admin-core-api",
    "copy": "npm run build && npm run copy-to-proxy-hetarchief && npm run copy-to-proxy-avo",
    "copy:avo": "npm run build && npm run copy-to-proxy-avo",
    "copy:hetarchief": "npm run build && npm run copy-to-proxy-hetarchief",
    "start": "dotenv -e .env/.env.local nest start",
    "dev": "dotenv -e .env/.env.local nest start --builder tsc",
    "start:debug": "dotenv -e .env/.env.local nest start -- --debug --watch",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:dev": "vitest run",
    "test:debug": "vitest --inspect-brk --run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "i18n:extract": "ts-node --transpile-only --require dotenv/config scripts/extract-and-replace-translations.ts dotenv_config_path=.env/.env.local && npm run format:fix",
    "generate-hetarchief-database-types": "dotenv -e ./.env/.env.local graphql-codegen -- --config codegen-hetarchief.ts",
    "generate-avo-database-types": "dotenv -e ./.env/.env.local graphql-codegen -- --config codegen-avo.ts",
    "generate-database-types": "npm run generate-hetarchief-database-types && npm run generate-avo-database-types",
    "bump": "bump-package-versions --part=patch --strategy=highest ../package.json ../ui/package.json ./package.json",
    "find-circular-dependencies": "npx madge --circular --extensions ts ./"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.717.0",
    "@smithy/protocol-http": "4.1.8",
    "@smithy/signature-v4": "4.2.4",
    "@viaa/avo2-types": "5.0.25",
    "app-root-path": "3.0.0",
    "blend-promise-utils": "^1.28.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "date-fns": "^2.28.0",
    "date-fns-tz": "^1.3.0",
    "express-session": "^1.17.2",
    "fs-extra": "^10.0.0",
    "got": "^11.8.3",
    "graphql": "17.0.2",
    "helmet": "^5.0.2",
    "i18next": "^21.6.3",
    "joi": "^17.13.3",
    "lodash": "^4.17.21",
    "public-ip": "^4.0.4",
    "query-string": "^7.1.0",
    "rimraf": "^3.0.2",
    "saml2-js": "^3.0.1",
    "session-file-store": "^1.5.0",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^4.3.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.18",
    "@types/express": "^5.0.6",
    "@types/joi": "^17.2.3",
    "@types/lodash": "^4.14.191",
    "@types/node": "^24.12.0",
    "@types/supertest": "^2.0.11",
    "@vitest/coverage-v8": "^3.0.0",
    "bump-package-versions": "^1.0.7",
    "cache-manager": "^7.2.9",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.2.1",
    "nock": "^13.2.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.3.0",
    "swagger-ui-express": "^4.5.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "cache-manager": ">=7",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "overrides": {
    "graphql": "$graphql"
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
